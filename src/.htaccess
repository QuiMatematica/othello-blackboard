RewriteEngine On

# index.php → /
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# Forza HTTPS + non-www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^bb\.quiothello\.it$ [NC]
RewriteRule ^(.*)$ https://bb.quiothello.it/$1 [R=301,L]

# MIME type per WebAssembly
AddType application/wasm .wasm

<IfModule mod_expires.c>
    ExpiresActive On

    # Default conservativo
    ExpiresDefault "access plus 1 hour"

    # Contenuto dinamico: nessuna cache
    ExpiresByType text/html "access plus 0 seconds"

    # Asset statici con versioning (hash nel nome file): cache lunga
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/wasm "access plus 1 year"

    # Immagini e font: cache media
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # HTML: sempre rivalidato
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Asset con versioning: cache immutabile
    <FilesMatch "\.(js|css|wasm|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Immagini: cache lunga ma rivalidabile
    <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>